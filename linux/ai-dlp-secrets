#!/usr/bin/python3 -I
"""Collect secret values and add them to ai-dlp's exact-match list.

Usage:
  ai-dlp-secrets [--pgpass] [--pass] [ENV_FILE ...]
  some-command | ai-dlp-secrets            # one secret per line on stdin

  ENV_FILE   KEY=VALUE files (.env style); every value is added
  --pgpass   password field of every line in ~/.pgpass
  --pass     first line of every entry in your `pass` store (gpg will ask to unlock)

Values shorter than 8 characters are skipped. Nothing is printed except counts.
The list is merged into /etc/ai-dlp/secrets.txt (readable only by root and the
proxy), using sudo in a terminal or pkexec otherwise.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

MIN_LEN = 4
MERGE = "/usr/local/lib/ai-dlp/merge-secrets"


def env_values(path: Path):
    for raw in path.read_text(errors="surrogateescape").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[len("export "):]
        value = line.split("=", 1)[1].strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        yield value


def pgpass_values(path: Path):
    for raw in path.read_text(errors="surrogateescape").splitlines():
        if not raw or raw.startswith("#"):
            continue
        fields, cur, esc = [], "", False
        for ch in raw:
            if esc:
                cur, esc = cur + ch, False
            elif ch == "\\":
                esc = True
            elif ch == ":" and len(fields) < 4:
                fields.append(cur)
                cur = ""
            else:
                cur += ch
        if len(fields) == 4:
            yield cur


def pass_values():
    store = Path(os.environ.get("PASSWORD_STORE_DIR", Path.home() / ".password-store"))
    for gpg in sorted(store.rglob("*.gpg")):
        name = str(gpg.relative_to(store))[:-4]
        out = subprocess.run(["pass", "show", name], capture_output=True, text=True)
        if out.returncode == 0 and out.stdout:
            yield out.stdout.splitlines()[0]
        else:
            print(f"  skipped pass entry (could not decrypt): {name}", file=sys.stderr)


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__)
        return 0
    values, sources = [], 0
    for arg in argv:
        if arg == "--pgpass":
            p = Path.home() / ".pgpass"
            if p.exists():
                values += pgpass_values(p)
                sources += 1
        elif arg == "--pass":
            values += pass_values()
            sources += 1
        else:
            values += env_values(Path(arg).expanduser())
            sources += 1
    if not sys.stdin.isatty():
        values += [l for l in sys.stdin.read().splitlines()]
        sources += 1
    if not sources:
        print(__doc__)
        return 2

    unique = sorted({v for v in values if len(v) >= MIN_LEN})
    skipped = len({v for v in values if 0 < len(v) < MIN_LEN})
    if not unique:
        print("No values of 8+ characters found; nothing to add.")
        return 0

    # The values go to the root helper on its stdin: they are never written to a file
    # that anyone else could read (sudo/pkexec ask for the password on the terminal or
    # in a dialog, not on stdin).
    data = ("\n".join(unique) + "\n").encode("utf-8", errors="surrogateescape")
    elevate = ["sudo"] if sys.stdout.isatty() and shutil.which("sudo") else ["pkexec"]
    subprocess.run(elevate + [MERGE], input=data, check=True)
    print(f"Added {len(unique)} value(s) to the ai-dlp secret list"
          + (f" ({skipped} shorter than {MIN_LEN} chars skipped)." if skipped else "."))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
