#!/bin/bash
# Root helper: merge new secret values, read one per line from stdin, into
# ai-dlp's list. Run by ai-dlp-secrets through sudo/pkexec.
set -euo pipefail
umask 077
dst=/etc/ai-dlp/secrets.txt
tmp=$(mktemp /etc/ai-dlp/.secrets.XXXXXX)
trap 'rm -f "$tmp"' EXIT
{ [[ -f $dst ]] && cat "$dst"; cat; } | awk 'length($0) >= 4 && !seen[$0]++' > "$tmp"
chown root:ai-dlp "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "$dst"
trap - EXIT
echo "ai-dlp secret list now holds $(wc -l < "$dst") value(s)."
