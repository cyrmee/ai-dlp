#!/usr/bin/python3 -I
"""Feed for the ai-dlp bar widget.

  dlpwatch watch        stream one JSON state object per line whenever something changes
  dlpwatch status       print the current state once
  dlpwatch detail ID    print what was redacted in one stored request:
                        {method, host, path, changes: [{rule, before, after, count}], total, file}

State: {installed, proxy, firewall, counts: {allowed, redacted, blocked, attachments} (today),
        recent: [newest-first events, at most RECENT], error}

Only reads the proxy's event log (action, host, path, rule names and counts;
it never contains secret values) and asks systemd whether the units are active.
"""

import json
import os
import re
import subprocess
import sys
import time
from datetime import date, datetime
from pathlib import Path

EVENTS = Path(os.environ.get("AI_DLP_EVENTS", "/var/log/ai-dlp/events.jsonl"))
ROTATED = EVENTS.with_name(EVENTS.name + ".1")
RECENT = 200
REQUESTS = Path(os.environ.get("AI_DLP_REQUESTS_DIR", "/var/log/ai-dlp/requests"))
CONTEXT = 70          # characters of surrounding text shown on each side of a redaction
MAX_CHANGES = 30
REDACTION = re.compile(r"\[REDACTED:([A-Za-z0-9_.\-]{1,64})\]")
REQUEST_ID = re.compile(r"^\d{13}-[0-9a-f]{8}$")
POLL = 0.5
STATUS_EVERY = 5.0
ACTIONS = ("allowed", "redacted", "blocked")


def bounded(value, limit):
    return str(value if value is not None else "")[:limit]


def clean(event):
    """Keep only known fields, bounded, from an untrusted log line."""
    if not isinstance(event, dict) or event.get("action") not in ACTIONS:
        return None
    rules = event.get("rules") if isinstance(event.get("rules"), dict) else {}
    attachments = event.get("attachments") if isinstance(event.get("attachments"), list) else []
    return {
        "time": int(event.get("time") or 0),
        "action": event["action"],
        "host": bounded(event.get("host"), 253),
        "method": bounded(event.get("method"), 10),
        "path": bounded(event.get("path"), 200),
        "bytes": max(0, int(event.get("bytes") or 0)),
        "rules": {bounded(k, 64): max(0, int(v or 0)) for k, v in list(rules.items())[:20]},
        "reason": bounded(event.get("reason"), 200),
        "test": event.get("test") is True,
        "id": event["id"] if isinstance(event.get("id"), str) and REQUEST_ID.match(event["id"]) else "",
        "notes": [bounded(n, 200) for n in (event.get("notes") or [])[:20] if isinstance(n, str)],
        "attachments": [
            {"kind": bounded(a.get("kind"), 16), "media": bounded(a.get("media"), 80),
             "bytes": max(0, int(a.get("bytes") or 0)), "name": bounded(a.get("name"), 120),
             "source": bounded(a.get("source"), 20)}
            for a in attachments[:20] if isinstance(a, dict)
        ],
    }


def parse(line):
    try:
        return clean(json.loads(line))
    except (ValueError, TypeError):
        return None


def unit_state(unit):
    try:
        out = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True, timeout=5)
        return out.stdout.strip() or "unknown"
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"


def installed():
    return Path("/etc/systemd/system/ai-dlp-proxy.service").exists()


class Feed:
    def __init__(self):
        self.recent = []
        self.counts = {**dict.fromkeys(ACTIONS, 0), "attachments": 0}
        self.day = date.today()
        self.proxy = self.firewall = "unknown"
        self.error = ""
        self.handle = None
        self.inode = None
        self.buffer = ""

    def add(self, event):
        if event is None:
            return
        if datetime.fromtimestamp(event["time"] / 1000).date() == self.day:
            self.counts[event["action"]] += 1
            if not event["test"]:
                self.counts["attachments"] += len(event["attachments"])
        self.recent.insert(0, event)
        del self.recent[RECENT:]

    def load_history(self):
        lines = []
        for path in (ROTATED, EVENTS):
            try:
                lines += path.read_text(encoding="utf-8", errors="replace").splitlines()
            except OSError:
                pass
        for line in lines:
            self.add(parse(line))

    def open_log(self, seek_end):
        try:
            handle = EVENTS.open("r", encoding="utf-8", errors="replace")
        except OSError:
            self.handle, self.inode = None, None
            return
        if seek_end:
            handle.seek(0, os.SEEK_END)
        self.handle, self.inode, self.buffer = handle, os.fstat(handle.fileno()).st_ino, ""

    def poll_log(self):
        """Read new lines; reopen after rotation. Returns True if anything was added."""
        changed = False
        try:
            st = EVENTS.stat()
        except OSError:
            st = None
        if self.handle is None:
            if st is not None:
                self.open_log(seek_end=False)
        elif st is None or st.st_ino != self.inode or st.st_size < self.handle.tell():
            self.handle.close()
            self.open_log(seek_end=False)
        if self.handle is not None:
            chunk = self.handle.read(1_000_000)
            if chunk:
                self.buffer += chunk
                *complete, self.buffer = self.buffer.split("\n")
                for line in complete:
                    event = parse(line)
                    if event:
                        self.add(event)
                        changed = True
        if date.today() != self.day:
            self.day, self.counts = date.today(), {**dict.fromkeys(ACTIONS, 0), "attachments": 0}
            changed = True
        return changed

    def poll_status(self):
        before = (self.proxy, self.firewall, self.error)
        if installed():
            self.proxy, self.firewall = unit_state("ai-dlp-proxy"), unit_state("ai-dlp-firewall")
            self.error = "" if EVENTS.parent.exists() or self.proxy != "active" else "event log missing"
        else:
            self.proxy = self.firewall = "missing"
            self.error = ""
        return (self.proxy, self.firewall, self.error) != before

    def state(self):
        return {"installed": self.proxy != "missing", "proxy": self.proxy, "firewall": self.firewall,
                "counts": self.counts, "recent": self.recent, "error": self.error}


def emit(feed):
    sys.stdout.write(json.dumps(feed.state()) + "\n")
    sys.stdout.flush()


def detail(rid):
    """One stored request, bounded; ids are checked so no other file can be read."""
    if not REQUEST_ID.match(rid or ""):
        return {"error": "invalid request id"}
    path = REQUESTS / f"{rid}.json"
    try:
        record = json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except FileNotFoundError:
        return {"error": "not stored any more (only the last requests are kept)"}
    except PermissionError:
        return {"error": "no permission to read stored requests (re-run the installer)"}
    except (OSError, ValueError) as e:
        return {"error": f"could not read the stored request: {e}"[:200]}
    body = record.get("body")
    return {
        "method": bounded(record.get("method"), 10),
        "host": bounded(record.get("host"), 253),
        "path": bounded(record.get("path"), 2000),
        "stored": isinstance(body, str),
        **changes(body if isinstance(body, str) else ""),
        "file": str(path),
    }


def _squash(text):
    return re.sub(r"\s+", " ", text)


def _strings(obj, out):
    if isinstance(obj, str):
        out.append(obj)
    elif isinstance(obj, dict):
        for value in obj.values():
            _strings(value, out)
    elif isinstance(obj, list):
        for value in obj:
            _strings(value, out)


def changes(body):
    """Each redaction with a little of the text around it, taken from inside the text value
    that holds it (so no JSON wrapping). The stored copy is already redacted, so no secret
    value can appear here. Identical snippets (a conversation resends the same text every
    turn) are counted once."""
    try:
        texts = []
        _strings(json.loads(body), texts)
    except ValueError:
        texts = [body]
    found, order = {}, []
    for text in texts:
        for m in REDACTION.finditer(text):
            before = _squash(text[max(0, m.start() - CONTEXT * 2):m.start()])
            after = _squash(text[m.end():m.end() + CONTEXT * 2])
            before = ("…" + before[-CONTEXT:].lstrip()) if len(before) > CONTEXT or m.start() > CONTEXT * 2 else before
            after = (after[:CONTEXT].rstrip() + "…") if len(after) > CONTEXT or len(text) - m.end() > CONTEXT * 2 else after
            key = (m.group(1), before, after)
            if key not in found:
                found[key] = 0
                order.append(key)
            found[key] += 1
    items = [{"rule": r, "before": b, "after": a, "count": found[(r, b, a)]} for r, b, a in order]
    return {"changes": items[:MAX_CHANGES], "total": sum(found.values()), "distinct": len(items)}


def main(argv):
    mode = argv[0] if argv else "status"
    if mode == "detail":
        print(json.dumps(detail(argv[1] if len(argv) > 1 else "")))
        return 0
    feed = Feed()
    feed.load_history()
    feed.poll_status()
    if mode == "status":
        emit(feed)
        return 0
    if mode != "watch":
        print(__doc__, file=sys.stderr)
        return 2
    feed.open_log(seek_end=True)
    emit(feed)
    last_status = time.monotonic()
    try:
        while True:
            time.sleep(POLL)
            changed = feed.poll_log()
            if time.monotonic() - last_status >= STATUS_EVERY:
                last_status = time.monotonic()
                changed |= feed.poll_status()
            if changed:
                emit(feed)
    except (BrokenPipeError, KeyboardInterrupt):
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
